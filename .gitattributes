# Normalize line endings in the repository to LF, regardless of platform.
* text=auto

*.go text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sh text eol=lf

# Generated lockfile must not be re-normalized by tooling.
package-lock.json text eol=lf